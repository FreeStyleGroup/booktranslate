# Обратный прокси перед витриной и API.
#
# Сертификаты Caddy получает и продлевает сам — при условии, что оба домена
# указывают на эту машину и порты 80 и 443 открыты.
#
# X-Forwarded-For ставит сам Caddy — адрес соединения. Значение, пришедшее
# от посетителя, он отбрасывает: посетитель не доверенный прокси. На этом
# держится ограничитель частоты в API: адресу в заголовке можно верить.

# ── Витрина ──
#
# Адрес сайта берётся из WEB_SITE, а не из WEB_DOMAIN: на голом домене
# (booktranslate.ru) сертификат нужен и на «www», иначе у половины
# посетителей — тех, кто набирает адрес по привычке с «www», — сайт не
# откроется вовсе. WEB_SITE тогда содержит оба имени через запятую, а
# WEB_DOMAIN остаётся каноническим: на него ведёт перенаправление ниже и
# по нему выдаются печенья сеанса. На поддомене (app.example.ru) WEB_SITE
# равен WEB_DOMAIN, и правило ниже просто никогда не срабатывает.
{$WEB_SITE} {
	# Одна страница — один адрес. Без этого «www» и голый домен работают
	# как два разных сайта: поисковик делит между ними вес, а печенья
	# сеанса, выданные на одном, не видны на другом.
	@www host www.{$WEB_DOMAIN}
	redir @www https://{$WEB_DOMAIN}{uri} permanent

	# Витрина принимает только формы входа и регистрации — килобайты.
	# Без потолка тело на гигабайт буферизуется в памяти Node до OOM,
	# и на время атаки вход недоступен.
	request_body {
		max_size 1MB
	}

	reverse_proxy web:3000 {
		transport http {
			read_timeout 60s
			write_timeout 60s
		}
	}

	encode zstd gzip

	# Заголовки безопасности витрина ставит сама (next.config.ts) — здесь их
	# не дублируем: два одинаковых Strict-Transport-Security это не «надёжнее»,
	# а мусор в ответе. Убираем только подпись сервера.
	header -Server

	log {
		output stdout
		format json
	}
}

# ── API ──
{$API_DOMAIN} {
	# Загрузка книги — это десятки мегабайт; умолчание прокси обрезало бы
	# её раньше, чем до неё дойдёт проверка размера в приложении.
	request_body {
		max_size 60MB
	}

	# Перевод книги идёт синхронно и занимает минуты: короткий таймаут
	# оборвал бы прогон на середине, оставив документ наполовину
	# переведённым.
	reverse_proxy api:8000 {
		transport http {
			read_timeout 15m
			write_timeout 15m
		}
	}

	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		# API отдаёт JSON и файлы, показывать его в кадре незачем.
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		-Server
	}

	log {
		output stdout
		format json
	}
}
