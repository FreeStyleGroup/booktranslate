# Скопируйте в .env и поправьте под себя. Сам .env в репозиторий не попадает.

ENVIRONMENT=development
DEBUG=false

# Внутри docker compose хост базы — имя сервиса (postgres), а не localhost.
DATABASE_URL=postgresql+asyncpg://booktranslate:booktranslate@postgres:5432/booktranslate

# Откуда витрине разрешено обращаться к API. Продакшен-адрес Vercel
# добавляется сюда же, через запятую в JSON-формате списка. Звёздочка вне
# разработки запрещена: приложение с ней не поднимется.
CORS_ORIGINS=["http://localhost:3000"]

# Имена, под которыми API отвечает. Звёздочка годится для разработки; вне
# её список обязателен — он закрывает подмену заголовка Host.
ALLOWED_HOSTS=["*"]

# Запросов с одного адреса в минуту: общий потолок и отдельный, строгий,
# для входа и регистрации. Проверка пароля считается Argon2id и по замыслу
# дорогая: без отдельной меры десяток запросов кладёт сервер целиком.
RATE_LIMIT_PER_MINUTE=300
AUTH_RATE_LIMIT_PER_MINUTE=10

# Ключ подписи токенов. Вне разработки приложение откажется стартовать со
# значением по умолчанию: подделать токен сможет любой, кто видел исходники.
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-secret-change-me

# Доступ живёт минуты, обновление — недели. Украденный access протухает
# сам, refresh лежит в базе и отзывается принудительно.
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# Где лежат исходные файлы документов. Каталог на диске — решение на время
# разработки и одного сервера; в рабочей среде сюда встанет объектное
# хранилище (интерфейс в app/services/storage.py к этому готов).
STORAGE_ROOT=./var/storage

# Потолок размера загружаемого файла в мегабайтах. Проверяется по мере
# чтения, а не после приёма целиком.
MAX_UPLOAD_MB=50

# Сколько сегментов разрешено перевести одним запуском и сколько терминов
# брать в работу. Первое — от повторного нажатия и цикла в чужом скрипте
# (каждый прогон стоит денег), второе — от чужой термбазы, загруженной
# целиком: каждый термин прогоняется по каждому сегменту.
TRANSLATION_MAX_SEGMENTS_PER_RUN=20000
GLOSSARY_MAX_ACTIVE_TERMS=5000

# ── Провайдер перевода ──
# stub — заглушка: весь конвейер работает, но ничего не стоит и никуда не
# ходит. claude — настоящий перевод. Умолчание «stub» намеренное: разработка
# и CI не должны тратить деньги, рабочая среда включает модель явно.
TRANSLATION_PROVIDER=stub

# Ключ модели. Напрямую в Anthropic — ключ вида «sk-ant-…»; через шлюз —
# ключ шлюза (у AITunnel «sk-aitunnel-…»). Можно не задавать вовсе: тогда
# клиент возьмёт ANTHROPIC_API_KEY из окружения или профиль машины.
# ANTHROPIC_API_KEY=

# Адрес совместимого шлюза. Пусто — обращаться в Anthropic напрямую. Шлюз
# принимает те же запросы к /v1/messages, оплачивается в рублях и работает
# из России без обходных путей. Ключ шлюза уходит заголовком
# «Authorization: Bearer» — приложение делает это само.
#   AITunnel: https://api.aitunnel.ru   (без «/v1» — путь добавляет клиент)
# ANTHROPIC_BASE_URL=

# Имя модели. У шлюза свой каталог, и имена в нём отличаются: сверяйтесь со
# списком шлюза, а не с документацией Anthropic. Оценка стоимости считается
# по прейскуранту Anthropic (app/services/pricing.py), поэтому для модели
# шлюза она не выводится: токены остаются, деньги — по счёту шлюза.
ANTHROPIC_MODEL=claude-opus-5

# Потолок ответа. Пачка, в него не уместившаяся, переводится половинами.
ANTHROPIC_MAX_TOKENS=16000

# Глубина работы модели: low | medium | high | xhigh | max. Пусто —
# умолчание модели. Подбирается на реальной книге, а не угадывается.
ANTHROPIC_EFFORT=

# Перевод книги — сотни запросов подряд: сетевой сбой на середине не должен
# ронять весь документ.
ANTHROPIC_MAX_RETRIES=5
ANTHROPIC_TIMEOUT_SECONDS=600

# Запасная модель на случай отказа по правилам безопасности. Выключите, если
# у организации нет доступа к этой возможности: иначе запрос отвергается.
# Через шлюз выключается сама — это возможность Anthropic, и шлюз её не
# проксирует.
ANTHROPIC_USE_FALLBACKS=true

# Проверить связь, ключ и модель одним пробным переводом (доли копейки):
#   python -m app.cli check-provider
# Добавьте --lookup, чтобы заодно проверить поиск справок в интернете.

# ── Каталог терминов ──
# Где смотреть незнакомое слово: offline — нигде (каталог наполняется руками
# и импортом словарей), claude — модель с выходом в сеть. Умолчание закрытое:
# поиск ходит в интернет, оплачивается отдельно от перевода (поисковых
# запросов не видно в счётчиках токенов) и у заказчика с закрытым контуром
# может быть запрещён вовсе.
TERM_LOOKUP_PROVIDER=offline

# Потолок ответа на одну справку. Справка — это несколько предложений и
# список источников, а не глава.
TERM_LOOKUP_MAX_TOKENS=4000

# Сколько терминов ищется одновременно и сколько разрешено спросить за раз.
TERM_LOOKUP_CONCURRENCY=4
TERM_LOOKUP_BATCH=25
