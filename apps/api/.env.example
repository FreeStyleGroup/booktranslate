# Скопируйте в .env и поправьте под себя. Сам .env в репозиторий не попадает.

ENVIRONMENT=development
DEBUG=false

# Внутри docker compose хост базы — имя сервиса (postgres), а не localhost.
DATABASE_URL=postgresql+asyncpg://booktranslate:booktranslate@postgres:5432/booktranslate

# Откуда витрине разрешено обращаться к API. Продакшен-адрес Vercel
# добавляется сюда же, через запятую в JSON-формате списка.
CORS_ORIGINS=["http://localhost:3000"]

# Ключ подписи токенов. Вне разработки приложение откажется стартовать со
# значением по умолчанию: подделать токен сможет любой, кто видел исходники.
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-secret-change-me

# Доступ живёт минуты, обновление — недели. Украденный access протухает
# сам, refresh лежит в базе и отзывается принудительно.
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
