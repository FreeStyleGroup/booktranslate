# Рабочая среда. Скопируйте в .env В КОРНЕ репозитория (рядом с
# docker-compose.prod.yml) и заполните. Сам .env в репозиторий не попадает.
#
# Всё, что здесь помечено «обязательно», проверяется при старте: приложение
# откажется подниматься с ключом из примера. Лучше не подняться совсем, чем
# работать с секретом, который видел каждый, кто читал исходники.

# ── Обязательное ──

ENVIRONMENT=production
DEBUG=false

# Ключ подписи токенов. ОБЯЗАТЕЛЬНО свой:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Пароль базы. Тоже свой и тоже случайный — база наружу не смотрит, но
# пароль «booktranslate» переживёт первый же чужой контейнер на этой машине.
POSTGRES_PASSWORD=

# Домены. По ним Caddy получает сертификаты, поэтому оба должны уже
# указывать на эту машину к моменту запуска.
WEB_DOMAIN=app.example.ru
API_DOMAIN=api.example.ru

# Имена, под которыми API отвечает. Закрывает подмену заголовка Host.
# 🔥 «api» — имя сервиса в docker compose: по нему витрина ходит в API по
# внутренней сети. Без него API отвечает витрине 400, и кабинет показывает
# демонстрационные числа вместо настоящих, не объясняя почему.
ALLOWED_HOSTS=["api.example.ru","api"]

# Откуда браузеру разрешено обращаться к API напрямую. Сейчас витрина ходит
# в API только со своего сервера, и браузер к нему не обращается вовсе —
# список нужен на будущее и для витрины на Vercel. Звёздочка вне разработки
# запрещена: с ней любой сайт читает API от имени вошедшего.
CORS_ORIGINS=["https://app.example.ru"]

# ── Модель ──

# claude — настоящий перевод, stub — заглушка (ничего не стоит и никуда не
# ходит). В рабочей среде включается явно.
TRANSLATION_PROVIDER=claude

# Ключ: напрямую в Anthropic — «sk-ant-…», через шлюз — ключ шлюза.
ANTHROPIC_API_KEY=

# Шлюз. Пусто — напрямую в Anthropic. AITunnel: https://api.aitunnel.ru
# (без «/v1» — путь добавляет клиент). Ключ уходит заголовком
# «Authorization: Bearer», приложение делает это само.
ANTHROPIC_BASE_URL=

# Имя модели. У AITunnel имена совпадают с анthropic'овскими; у другого
# шлюза могут отличаться — сверяйтесь с его каталогом. Оценка стоимости
# считается по прейскуранту Anthropic в долларах, а счёт шлюз выставляет
# свой и в рублях: число показывает порядок, а не сумму к оплате.
ANTHROPIC_MODEL=claude-opus-5

# Проверить связь и ключ, не переводя книгу:
#   docker compose -f docker-compose.prod.yml exec api python -m app.cli check-provider

# Поиск справок о терминах ходит в интернет и оплачивается отдельно от
# перевода. Включайте осознанно: offline — выключен, claude — включён.
TERM_LOOKUP_PROVIDER=offline

# ── Меры и потолки ──

# Запросов с одного адреса в минуту: общий и отдельный, строгий, для входа.
# Адрес — посетителя, а не витрины: она передаёт его заголовком.
RATE_LIMIT_PER_MINUTE=300
AUTH_RATE_LIMIT_PER_MINUTE=10

# Потолок размера загружаемого файла (МБ) и числа сегментов за один прогон
# перевода. Второй — не от злого умысла, а от повторного нажатия: каждый
# прогон стоит денег.
MAX_UPLOAD_MB=50
TRANSLATION_MAX_SEGMENTS_PER_RUN=20000

# ── Образы ──

# Теги, которые выкатываются. Оба собираются одним тегом репозитория
# (v0.1.0 → 0.1.0), см. .github/workflows/release.yml. Тег версии, а не
# latest: по нему видно, что именно работает, и откат сводится к
# предыдущему тегу. Реестр приватный — перед pull нужен docker login
# (docs/DEPLOY.md).
API_IMAGE=ghcr.io/freestylegroup/booktranslate/api:0.1.0
WEB_IMAGE=ghcr.io/freestylegroup/booktranslate/web:0.1.0

# Кому верить в заголовках источника — сеть докера, где стоят прокси и
# витрина. Докер выдаёт сети из 172.17–172.31; если на машине они
# кончились и compose получил 192.168.х — впишите её сюда, иначе все
# посетители сольются для ограничителя частоты в одного. Проверить:
# docker network inspect booktranslate_default.
FORWARDED_ALLOW_IPS=172.16.0.0/12

# MTU сети compose. Пусто — 1500. bootstrap.sh задаёт сам, если интерфейс
# сервера урезан (reg.ru — 1450); на обычной машине не нужно.
#DOCKER_NETWORK_MTU=1400

# Порция перевода за один вызов и порог «брошенного» документа
TRANSLATION_DEFAULT_LIMIT=200
TRANSLATION_STALE_MINUTES=30
